# Copy to .env and fill in. DocuRetrieve reads these at startup.

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Supabase (free tier) — Project Settings > API
SUPABASE_URL=
SUPABASE_KEY=

# Set to "true" to run extraction against a local stub instead of calling Gemini.
# Useful for local dev / tests without a key.
DOCURETRIEVE_USE_STUB=false
